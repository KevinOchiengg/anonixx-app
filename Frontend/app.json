{
  "expo": {
    "name": "Anonixx",
    "slug": "anonixx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "anonixx",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f18"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonixx.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "Anonixx needs your microphone for anonymous voice and video calls.",
        "NSCameraUsageDescription": "Anonixx needs your camera for anonymous video calls."
      },
      "usesAppleSignIn": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f18"
      },
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "RECORD_AUDIO",
        "CAMERA",
        "com.android.vending.BILLING"
      ],
      "package": "com.anonixx.app",
      "navigationBarColor": "#151924",
      "navigationBarStyle": "dark",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "anonixx",
              "host": "confession"
            },
            {
              "scheme": "anonixx",
              "host": "market"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Anonixx",
      "shortName": "Anonixx",
      "description": "Anonymous emotion. Structured connection.",
      "themeColor": "#FF634A",
      "backgroundColor": "#0b0f18"
    },
    "plugins": [
      "expo-asset",
      "expo-video",
      "expo-navigation-bar",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.anonixx.app",
          "enableGooglePay": true
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "e6e5b944-ee40-4251-8b89-ff8a3e733ec2"
      }
    },
    "owner": "kotechnologies"
  }
}
