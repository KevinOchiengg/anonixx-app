# API URL
API_URL=http://192.168.100.22:8000/api/v1

# Tenor GIF search (used by comment composers, e.g. Circle comments) — get a
# free key at https://tenor.com/gifapi
EXPO_PUBLIC_TENOR_API_KEY=

# Required as of Expo SDK 57 — its default global fetch doesn't support the
# { uri, name, type } file objects every upload in this app (drop media,
# voice notes, comment/chat images) appends to FormData. Without this,
# uploads fail with "Unsupported FormDataPart implementation".
EXPO_PUBLIC_USE_RN_FETCH=1