# Backend API (FastAPI). Used by the server for SSR and by the browser for the live feed.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public URL of this site — canonical links, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hostname (no protocol/path) that serves uploaded media — must match the backend's
# R2_PUBLIC_URL domain. Required for next/image to load avatars/drop photos/videos.
NEXT_PUBLIC_MEDIA_HOST=

# Google AdSense publisher id (ca-pub-...). Leave empty to show Anonixx's own promo cards instead.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# App store links for the install prompts.
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_TENOR_API_KEY=

# Google sign-in: the OAuth "Web application" client ID (same value goes in the backend GOOGLE_CLIENT_IDS).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
