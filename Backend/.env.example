# App
APP_NAME=Anonixx
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
BASE_URL=https://your-production-domain.com

# Security
SECRET_KEY=your-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=anonixx

# Cloudflare R2 (media storage — avatars, drop photos/videos/voice notes, teaser cards)
# 1. Create a bucket in the Cloudflare dashboard (R2 > Create bucket)
# 2. R2 > Manage API tokens > create a token scoped to that bucket (gives you the key id/secret)
# 3. R2_ENDPOINT is https://<account_id>.r2.cloudflarestorage.com
# 4. R2_PUBLIC_URL is the bucket's public r2.dev URL, or a custom domain connected to it —
#    must match Web's NEXT_PUBLIC_MEDIA_HOST (no protocol there, just the hostname)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=anonixx
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.yourdomain.com

# M-Pesa
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/v1/webhooks/mpesa

# ── Social Publisher ─────────────────────────────────────────────────────────

# TikTok
# 1. Go to https://developers.tiktok.com and create an app
# 2. Enable scopes: video.publish  video.upload
# 3. Complete OAuth for the Anonixx brand TikTok account
# 4. Exchange for a long-lived token (valid 365 days)
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token-here

# Facebook Page
# 1. Create a Meta app at https://developers.facebook.com
# 2. Add "Pages" product — grant: pages_manage_posts  pages_read_engagement
# 3. Generate a Page Access Token via Graph API Explorer
# 4. Exchange for a long-lived token (valid ~60 days, refresh before expiry)
FACEBOOK_PAGE_ID=your-facebook-page-id-here
FACEBOOK_PAGE_ACCESS_TOKEN=your-facebook-page-access-token-here

# Instagram Business Account (linked to the Facebook Page above)
# Find the ID by calling:
#   GET https://graph.facebook.com/v21.0/{FACEBOOK_PAGE_ID}
#       ?fields=instagram_business_account&access_token={FACEBOOK_PAGE_ACCESS_TOKEN}
# Note: uses the same FACEBOOK_PAGE_ACCESS_TOKEN — no separate token needed
INSTAGRAM_ACCOUNT_ID=your-instagram-account-id-here

# Anthropic (AI writer for guided hookup confessions). Server-side only, never in the app.
# Get a key at https://console.anthropic.com > API keys. Empty = the writer is off and
# people write their confession themselves.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Resend (email / password reset OTPs)
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=Anonixx <noreply@anonixx.com>

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_client_id
PAYPAL_CLIENT_SECRET=your_client_secret
PAYPAL_WEBHOOK_ID=your_webhook_id

# Coin Pricing
COIN_PACK_100_KES=99
COIN_PACK_500_KES=499
COIN_PACK_1000_KES=899
COIN_PACK_100_USD=0.99
COIN_PACK_500_USD=4.99
COIN_PACK_1000_USD=8.99

# CORS
CORS_ORIGINS=["http://localhost:8081","https://yourdomain.com"]

#FOR PRODUCTION
# MongoDB
MONGODB_URI=mongodb+srv://your_db_user:your_db_password@your-cluster.mongodb.net/
MONGODB_DB=anonixx

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Environment
ENVIRONMENT=production
```

---

### **1.5 Update `.gitignore`**

**FILE: `backend/.gitignore`**
```
.env
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
env/
.venv
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
.DS_Store
# Comma-separated emails of super admins (account must also have is_admin=true)
SUPER_ADMIN_EMAILS=

# Google sign-in: comma-separated OAuth client IDs (web, plus Android/iOS if used)
GOOGLE_CLIENT_IDS=

# WhatsApp Cloud API (anonymous drop relay)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=any-random-string-you-also-enter-in-meta-dashboard
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=anonixx_message_request
WHATSAPP_TEMPLATE_LANG=en

# Cloudflare Stream (video drops: encoding, cutting, the Anonixx watermark, adaptive playback)
# Leave empty to keep video drops on R2. To switch on:
# 1. Cloudflare dashboard > Stream: enable it and buy a storage block ($5 / 1,000 minutes)
# 2. My Profile > API Tokens: create a token with Account > Stream > Edit
# 3. python scripts/stream_setup.py path/to/anonixx-logo.png  -> prints STREAM_WATERMARK_UID
CF_ACCOUNT_ID=
CF_STREAM_TOKEN=
STREAM_WATERMARK_UID=
